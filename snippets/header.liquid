<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Channaira home">
      <svg class="logo-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1"/>
        <path d="M27 13.5c-1 4.2-4.4 6.7-7 6.7-2.6 0-6-2.5-7-6.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M20 20.2V30" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        <circle cx="20" cy="12.2" r="1.6" fill="currentColor"/>
      </svg>
      <span class="logo-word">CHANNAIRA</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#collections">Collections</a>
      <a href="#bestsellers">Bestsellers</a>
      <a href="#deals">Deals</a>
      <a href="#story">Our Story</a>
      <a href="#newsletter">Newsletter</a>
    </nav>
    <div class="nav-actions">
      <a class="icon-btn" href="/cart" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
      </a>
      <button class="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <a href="#collections">Collections</a>
  <a href="#bestsellers">Bestsellers</a>
  <a href="#deals">Deals</a>
  <a href="#story">Our Story</a>
  <a href="#newsletter">Newsletter</a>
  <a href="/cart">Cart</a>
  <div class="mm-actions">
    <a class="btn btn--outline btn--sm" href="/cart">View Cart</a>
  </div>
</div>
